test_case_suite(
    name = "gson-tests",
    test_cases = TEST_CASES,
    test_class = "net.thisptr.jackson.jq.v2.test.providers.gson.GsonJsonQueryTest",
    test_library = "//tests/src/test/java/net/thisptr/jackson/jq/v2/test/providers/gson",
    visibility = ["//visibility:private"],
