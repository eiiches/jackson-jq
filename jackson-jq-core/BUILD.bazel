load("@rules_java//java:defs.bzl", "java_library")
load("//build-tools/bazel:defs.bzl", "jjq_java_library", "jjq_java_mrjar", "jjq_maven_artifact")
load("//build-tools/bazel:javacc.bzl", "javacc")

package(default_visibility = ["//visibility:public"])

javacc(
    name = "ast_parser_srcs",
    generated_files = [
        "AstParser.java",
        "AstParserConstants.java",
        "AstParserTokenManager.java",
        "ParseException.java",
        "SimpleCharStream.java",
        "Token.java",
        "TokenMgrError.java",
    ],
    grammar = "src/main/javacc/json-query.jj",
    package = "net.thisptr.jackson.jq.v2.internal.javacc",
)

# The jq module fixtures the module-loader tests read off the classpath. They belong to no
# single Java package, so they are their own library. It stays out of
# jjq_java_mrjar(packages) below: the published artifact carries no fixtures.
java_library(
    name = "test-resources",
    testonly = True,
    resource_strip_prefix = "jackson-jq-core/src/test/resources",
    resources = glob(["src/test/resources/**"]),
    visibility = ["//jackson-jq-core:__subpackages__"],
)

# jackson-jq-core is the one module whose main sources are still reached by pattern rather
# than by name. What the glob picks up is the 23-package cycle documented in
# docs/package-cycles.md, which cannot be split until that is untangled, plus
# net.thisptr.jackson.jq.v2.core.module: that package is itself acyclic, but giving its
# directory a BUILD.bazel would make it a Bazel package and hide its core.module.loaders
# subdirectory from this glob, and loaders is inside the cycle. Every package that is
# outside the cycle and can stand alone is a target of its own, listed in packages below.
# The glob lives here, at the call site, rather than hidden in a macro default.
# src/test/java is split per package like every other module. checkstyle_srcs repeats the
# glob only to keep the generated parser out.
jjq_java_library(
    name = "core-sources",
    srcs = glob(["src/main/java/**/*.java"]) + [
        ":ast_parser_srcs",
        "//jackson-jq-core/src/main/java/net/thisptr/jackson/jq/v2/core/module:loaders-srcs",
    ],
    checkstyle_srcs = glob(["src/main/java/**/*.java"]) + [
        "//jackson-jq-core/src/main/java/net/thisptr/jackson/jq/v2/core/module:loaders-srcs",
    ],
    release = 8,
    visibility = ["//jackson-jq-core:__subpackages__"],
    deps = [
        "//jackson-jq-core/src/main/java/net/thisptr/jackson/jq/v2/core/diagnostic",
        "//jackson-jq-core/src/main/java/net/thisptr/jackson/jq/v2/core/function",
        "//jackson-jq-core/src/main/java/net/thisptr/jackson/jq/v2/core/function/loaders",
        "//jackson-jq-core/src/main/java/net/thisptr/jackson/jq/v2/core/internal/ast",
        "//jackson-jq-core/src/main/java/net/thisptr/jackson/jq/v2/core/internal/ast/operator",
        "//jackson-jq-core/src/main/java/net/thisptr/jackson/jq/v2/core/internal/ast/parser",
        "//jackson-jq-core/src/main/java/net/thisptr/jackson/jq/v2/core/internal/commons/collection",
        "//jackson-jq-core/src/main/java/net/thisptr/jackson/jq/v2/core/internal/commons/pair",
        "//jackson-jq-core/src/main/java/net/thisptr/jackson/jq/v2/core/internal/commons/range",
        "//jackson-jq-core/src/main/java/net/thisptr/jackson/jq/v2/core/internal/commons/strings",
        "//jackson-jq-core/src/main/java/net/thisptr/jackson/jq/v2/core/internal/compile/freevars",
        "//jackson-jq-core/src/main/java/net/thisptr/jackson/jq/v2/core/internal/exception",
        "//jackson-jq-core/src/main/java/net/thisptr/jackson/jq/v2/core/internal/function/loaders",
        "//jackson-jq-core/src/main/java/net/thisptr/jackson/jq/v2/core/internal/json",
        "//jackson-jq-core/src/main/java/net/thisptr/jackson/jq/v2/core/internal/json/comparator",
        "//jackson-jq-core/src/main/java/net/thisptr/jackson/jq/v2/core/internal/json/operations",
