@@ -85,10 +85,29 @@
     bufsize += 2048;
     available = bufsize;
     tokenBegin = 0;
   }
 
+  /**
+   * javacc signals end of input by throwing, and the recursive-descent parser's stack is deep
+   * when that happens, so filling in a stack trace per throw costs more than the rest of
+   * tokenizing a short query. The signal carries no state and never escapes
+   * AstParserTokenManager, which swallows it at every catch site, so one shared instance does
+   * the same job. The stack trace it holds is the one captured at class initialization and is
+   * meaningless; nothing reads it.
+   */
+  private static final java.io.IOException END_OF_INPUT = new java.io.IOException();
+
+  /**
+   * Whether inputStream has already reported end of input and been closed. readChar() keeps
+   * probing past the end, and without this latch each probe would call read() on the closed
+   * stream, which answers with a freshly allocated IOException of its own -- exactly the cost
+   * END_OF_INPUT exists to avoid. Reset wherever inputStream is; the constructors get false
+   * from the field initializer.
+   */
+  private boolean atEof;
+
   protected void FillBuff() throws java.io.IOException
   {
     if (maxNextCharInd == available)
     {
       if (available == bufsize)
@@ -111,14 +130,17 @@
