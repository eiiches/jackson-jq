load("@rules_java//java:defs.bzl", "java_binary")

package(default_visibility = ["//visibility:public"])

# A randomized differential tester: generates random jq ASTs and compares jackson-jq's
# result against a real jq subprocess. Reaches into core.internal.ast.*, so it runs on
# the classpath only, never as a JPMS module.
java_binary(
    name = "jackson-jq-fuzz",
    testonly = True,
    main_class = "net.thisptr.jackson.jq.v2.fuzz.Main",
    runtime_deps = ["//jackson-jq-fuzz/src/main/java/net/thisptr/jackson/jq/v2/fuzz"],
)
