"""jackson-jq: a pure-Java, embeddable jq implementation with pluggable JSON providers."""

module(
    name = "jackson_jq",
    version = "2.0.0",
)

# rules_java MUST be pinned explicitly at >= 9.9.0. It selects java_tools v21.0, which
# bundles error_prone_core 2.50.0 -- the exact version the build requires. Minimal
# version selection would otherwise settle on 9.3.0 (rules_jvm_external's floor), which
# brings java_tools v19.0 / Error Prone 2.46.0, where -Xep:ExposedPrivateType is not
# available. JavaBuilder always passes -XepIgnoreUnknownCheckNames, so keeping this pin
# prevents the check from being silently ignored.
bazel_dep(name = "rules_java", version = "9.9.0")
bazel_dep(name = "rules_jvm_external", version = "7.1")
bazel_dep(name = "contrib_rules_jvm", version = "0.34.0")
bazel_dep(name = "buildifier_prebuilt", version = "8.5.1.3")
bazel_dep(name = "rules_jq", version = "0.0.0")
local_path_override(
    module_name = "rules_jq",
    path = "build-tools/rules_jq",
)

JACKSON2_VERSION = "2.22.1"

JACKSON3_VERSION = "3.2.1"

JUNIT_VERSION = "6.1.3"

SLF4J_VERSION = "2.0.18"

ERROR_PRONE_VERSION = "2.50.0"

maven = use_extension("@rules_jvm_external//:extensions.bzl", "maven")
maven.install(
    name = "maven",
    fail_if_repin_required = True,
    fetch_sources = True,
    # protobuf (a transitive bazel_dep) also contributes to a repo named "maven";
    # acknowledging it here keeps the resolution warning out of every build.
    known_contributing_modules = ["protobuf"],
    lock_file = "//:maven_install.json",
    repositories = ["https://repo1.maven.org/maven2"],
    strict_visibility = True,
)

# -- JSON providers -----------------------------------------------------------
maven.artifact(
    artifact = "jackson-annotations",
    group = "com.fasterxml.jackson.core",
    version = "2.22",
)
maven.artifact(
    artifact = "jackson-databind",
    group = "com.fasterxml.jackson.core",
    version = JACKSON2_VERSION,
)
maven.artifact(
    artifact = "jackson-core",
    group = "com.fasterxml.jackson.core",
    version = JACKSON2_VERSION,
)
maven.artifact(
    testonly = True,
    artifact = "jackson-dataformat-yaml",
    group = "com.fasterxml.jackson.dataformat",
    version = JACKSON2_VERSION,
)
maven.artifact(
    artifact = "jackson-databind",
    group = "tools.jackson.core",
    version = JACKSON3_VERSION,
)
maven.artifact(
    artifact = "jackson-core",
    group = "tools.jackson.core",
    version = JACKSON3_VERSION,
)
maven.artifact(
    artifact = "gson",
    group = "com.google.code.gson",
    version = "2.11.0",
)
maven.artifact(
    artifact = "jakarta.json-api",
    group = "jakarta.json",
    version = "2.1.3",
)
maven.artifact(
    artifact = "parsson",
    group = "org.eclipse.parsson",
    version = "1.1.9",
)

# -- runtime libraries --------------------------------------------------------
maven.artifact(
    artifact = "jcodings",
    group = "org.jruby.jcodings",
    version = "1.0.63",
)
maven.artifact(
    artifact = "joni",
    group = "org.jruby.joni",
    version = "2.2.6",
)
maven.artifact(
    artifact = "commons-cli",
    group = "commons-cli",
    version = "1.10.0",
)
maven.artifact(
    artifact = "guava",
    group = "com.google.guava",
    version = "33.4.8-jre",
)

# -- annotations --------------------------------------------------------------
maven.artifact(
    artifact = "jspecify",
    group = "org.jspecify",
    version = "1.0.0",
)
maven.artifact(
    artifact = "error_prone_annotations",
    group = "com.google.errorprone",
    version = ERROR_PRONE_VERSION,
)
maven.artifact(
    artifact = "auto-service",
    group = "com.google.auto.service",
    version = "1.1.1",
)
maven.artifact(
    artifact = "auto-service-annotations",
    group = "com.google.auto.service",
    version = "1.1.1",
)

# -- Error Prone plugin path --------------------------------------------------
# NullAway is loaded as an Error Prone *plugin check* off the annotation
# processor path. guava and checker-qual must be here explicitly:
# BlazeJavacMain.ClassloaderMaskingFileManager hides JavaBuilder's own jar from
# the processor classloader except for com.google.errorprone.*,
# com.google.common.{collect,base,regex}.* and
# org.checkerframework.errorprone.dataflow.*, while NullAway needs
# com.google.common.cache.* and org.checkerframework.dataflow.qual.*.
maven.artifact(
    artifact = "nullaway",
    group = "com.uber.nullaway",
    version = "0.13.8",
)
maven.artifact(
    artifact = "dataflow-nullaway",
    group = "org.checkerframework",
    version = "4.0.0",
)
maven.artifact(
    artifact = "checker-qual",
    group = "org.checkerframework",
    version = "4.0.0",
)

# -- build tools --------------------------------------------------------------
maven.artifact(
    artifact = "javacc",
    group = "net.java.dev.javacc",
    version = "7.0.13",
)
maven.artifact(
    artifact = "biz.aQute.bndlib",
    group = "biz.aQute.bnd",
    version = "7.3.0",
)

# Checkstyle 9.3 is what maven-checkstyle-plugin 3.6.0 resolves today; pinning
# it keeps build-tools/checkstyle/checkstyle.xml behaving identically.
maven.artifact(
    testonly = True,
    artifact = "checkstyle",
    group = "com.puppycrawl.tools",
    version = "9.3",
)
maven.artifact(
    testonly = True,
    artifact = "junit-jupiter-api",
    group = "org.junit.jupiter",
    version = JUNIT_VERSION,
)
maven.artifact(
    testonly = True,
    artifact = "junit-jupiter-params",
    group = "org.junit.jupiter",
    version = JUNIT_VERSION,
)
maven.artifact(
    testonly = True,
    artifact = "junit-jupiter-engine",
    group = "org.junit.jupiter",
    version = JUNIT_VERSION,
)
maven.artifact(
    testonly = True,
    artifact = "junit-platform-launcher",
    group = "org.junit.platform",
    version = JUNIT_VERSION,
)
maven.artifact(
    testonly = True,
    artifact = "junit-platform-reporting",
    group = "org.junit.platform",
    version = JUNIT_VERSION,
)
maven.artifact(
    testonly = True,
    artifact = "assertj-core",
    group = "org.assertj",
    version = "3.27.7",
)
maven.artifact(
    artifact = "slf4j-api",
    group = "org.slf4j",
    version = SLF4J_VERSION,
)
maven.artifact(
    testonly = True,
    artifact = "slf4j-simple",
    group = "org.slf4j",
    version = SLF4J_VERSION,
)
use_repo(maven, "maven")

# Real jq binaries for the conformance tests. The rules package owns the release
# catalog so tests do not depend on whichever jq executables happen to be on PATH.
jq = use_extension("@rules_jq//:extensions.bzl", "jq", dev_dependency = True)
use_repo(jq, "jq_binaries")

http_file = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_file")

http_file(
    name = "intellij_code_formatter",
    downloaded_file_path = "intellij-code-formatter.jar",
    sha256 = "32eebd2924499f4956648ff457e7033321f583ff541ad075328c9a2c1df6e0ef",
    urls = ["https://github.com/ICIJ/intellij-code-formatter/releases/download/0.0.3/intellij-code-formatter-0.0.3.jar"],
)
