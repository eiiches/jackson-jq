"""jackson-jq: a pure-Java, embeddable jq implementation with pluggable JSON providers."""

module(
    name = "jackson_jq",
    version = "2.0.0",
)

# rules_java MUST be pinned explicitly at >= 9.9.0. It selects java_tools v21.0, which
# bundles error_prone_core 2.50.0 -- the exact version the build requires. Minimal
# version selection would otherwise settle on 9.3.0 (rules_jvm_external's floor), which
# brings java_tools v19.0 / Error Prone 2.46.0, where -Xep:ExposedPrivateType is not
# available. JavaBuilder always passes -XepIgnoreUnknownCheckNames, so keeping this pin
# prevents the check from being silently ignored.
bazel_dep(name = "rules_java", version = "9.9.0")
bazel_dep(name = "rules_jvm_external", version = "7.1")
bazel_dep(name = "contrib_rules_jvm", version = "0.34.0")
bazel_dep(name = "buildifier_prebuilt", version = "8.5.1.4")
bazel_dep(name = "rules_jq", version = "0.0.0")
local_path_override(
    module_name = "rules_jq",
    path = "build-tools/rules_jq",
)

JACKSON2_VERSION = "2.22.1"

JACKSON3_VERSION = "3.2.1"

JUNIT_VERSION = "6.1.3"

SLF4J_VERSION = "2.0.18"

ERROR_PRONE_VERSION = "2.50.0"

maven = use_extension("@rules_jvm_external//:extensions.bzl", "maven")
maven.install(
    name = "maven",
    fail_if_repin_required = True,
    fetch_sources = True,
    # protobuf (a transitive bazel_dep) also contributes to a repo named "maven";
    # acknowledging it here keeps the resolution warning out of every build.
    known_contributing_modules = ["protobuf"],
    lock_file = "//:maven_install.json",
    repositories = ["https://repo1.maven.org/maven2"],
    strict_visibility = True,
)

