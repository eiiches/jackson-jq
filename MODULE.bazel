# Real jq binaries for the conformance tests. The rules package owns the release
# catalog so tests do not depend on whichever jq executables happen to be on PATH.
jq = use_extension("@rules_jq//:extensions.bzl", "jq", dev_dependency = True)
use_repo(jq, "jq_binaries")

