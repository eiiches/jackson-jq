# -- Error Prone plugin path --------------------------------------------------
# NullAway is loaded as an Error Prone *plugin check* off the annotation
# processor path. guava and checker-qual must be here explicitly:
# BlazeJavacMain.ClassloaderMaskingFileManager hides JavaBuilder's own jar from
# the processor classloader except for com.google.errorprone.*,
# com.google.common.{collect,base,regex}.* and
# org.checkerframework.errorprone.dataflow.*, while NullAway needs
# com.google.common.cache.* and org.checkerframework.dataflow.qual.*.
maven.artifact(
    artifact = "nullaway",
    group = "com.uber.nullaway",
    version = "0.13.8",
)
maven.artifact(
    artifact = "dataflow-nullaway",
    group = "org.checkerframework",
    version = "4.0.0",
)
maven.artifact(
    artifact = "checker-qual",
    group = "org.checkerframework",
    version = "4.0.0",
)

