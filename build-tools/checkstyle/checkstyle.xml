<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
	"-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
	"https://checkstyle.org/dtds/configuration_1_3.dtd">

<module name="Checker">
	<property name="charset" value="UTF-8"/>

	<module name="NewlineAtEndOfFile"/>

	<module name="TreeWalker">
		<module name="AvoidStarImport">
			<property name="allowClassImports" value="false"/>
			<property name="allowStaticMemberImports" value="false"/>
		</module>
		<module name="AvoidStaticImport">
			<property name="excludes"
				value="org.junit.jupiter.api.Assertions.*, org.assertj.core.api.Assertions.*"/>
		</module>
		<module name="IllegalImport">
			<property name="regexp" value="true"/>
			<property name="illegalPkgs" value="sun"/>
			<property name="illegalClasses"
				value=".*\.[A-Z][A-Za-z0-9_$]*\.[A-Z][A-Za-z0-9_$]*"/>
			<message key="import.illegal"
				value="Nested types must be referenced through their enclosing type instead of imported: {0}"/>
		</module>
		<module name="RedundantImport"/>
		<module name="UnusedImports"/>

		<module name="RedundantModifier"/>
		<module name="ModifierOrder"/>
		<module name="EqualsHashCode"/>
		<module name="EmptyStatement"/>

		<module name="CustomImportOrder">
			<property name="customImportOrderRules"
				value="STANDARD_JAVA_PACKAGE###THIRD_PARTY_PACKAGE###SPECIAL_IMPORTS###STATIC"/>
			<property name="standardPackageRegExp" value="^(java|javax)\."/>
			<property name="specialImportsRegExp" value="^net\.thisptr\.jackson\.jq\.v2\."/>
			<property name="separateLineBetweenGroups" value="true"/>
			<property name="sortImportsInGroupAlphabetically" value="true"/>
		</module>
	</module>
</module>
